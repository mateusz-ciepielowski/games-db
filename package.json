{
  "name": "games-db",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "db:studio": "prisma studio",
    "db:check": "tsx scripts/check-database.ts",
    "test:integration": "tsx tests/auth.integration.mts",
    "format": "prettier --write app components lib scripts tests next.config.ts postcss.config.mjs README.md docs",
    "test:mail": "node --conditions=react-server --import tsx tests/mail.integration.mts",
    "smtp:check": "tsx scripts/check-smtp.ts",
    "igdb:check": "node --conditions=react-server --import tsx scripts/check-igdb.mts",
    "test:igdb": "node --conditions=react-server --import tsx tests/igdb-client.integration.mts",
    "test:played": "tsx tests/played-games.integration.mts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@conform-to/react": "1.21.2",
    "@conform-to/zod": "1.21.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "bcrypt": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.544.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "nodemailer": "10.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "uuid": "13.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcrypt": "6.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "ts-node": "10.9.2",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.21.4"
    }
  }
}
